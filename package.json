{
  "name": "resonantgraph-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build && cross-env NODE_ENV=development electron electron/dist/main.js",
    "electron:start": "npm run electron:build && electron electron/dist/main.js",
    "electron:package": "npm run build && npm run electron:build && electron-builder",
    "electron:package:mac": "npm run build && npm run electron:build && electron-builder --mac",
    "electron:package:win": "npm run build && npm run electron:build && electron-builder --win",
    "electron:package:linux": "npm run build && npm run electron:build && electron-builder --linux",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@sentry/react": "^10.25.0",
    "@sentry/tracing": "^7.120.4",
    "@stripe/stripe-js": "^8.6.0",
    "@tanstack/react-table": "^8.11.8",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.181.0",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.7.4",
    "cytoscape": "^3.29.2",
    "echarts": "^5.5.1",
    "html2canvas": "^1.4.1",
    "immer": "^11.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.556.0",
    "monaco-editor": "^0.45.0",
    "monaco-languageclient": "^10.4.0",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.1",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^2.8.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.181.2",
    "vscode-ws-jsonrpc": "^3.5.0",
    "y-monaco": "^0.1.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-onboarding": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.2",
    "@types/react-helmet-async": "^1.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.0.14",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.7.0",
    "electron": "^39.2.5",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.6.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-storybook": "^10.0.8",
    "jsdom": "^27.2.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "^10.0.8",
    "terser": "^5.44.1",
    "typescript": "^5.5.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.14"
  }
}
