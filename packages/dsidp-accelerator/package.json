{
  "name": "@resonantgenesis/dsidp-accelerator",
  "version": "1.0.0",
  "description": "DSID-P IDE Accelerator - Make any IDE 3-5x faster with parallel execution, semantic caching, and governance verification",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "require": "./dist/react.js",
      "types": "./dist/react.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/react.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ide",
    "accelerator",
    "dsidp",
    "parallel-execution",
    "caching",
    "governance",
    "ai-agent",
    "vscode",
    "windsurf",
    "cursor",
    "jetbrains"
  ],
  "author": "ResonantGenesis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/resonantgenesis/dsidp-accelerator"
  },
  "homepage": "https://resonantgenesis.com/dsidp-accelerator",
  "bugs": {
    "url": "https://github.com/resonantgenesis/dsidp-accelerator/issues"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
