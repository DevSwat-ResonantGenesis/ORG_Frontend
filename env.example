# ResonantGraph AI Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL
VITE_FASTAPI_URL=http://localhost:8001
# For production: https://api.resonant.dev-swat.com

# Developer Tools Services
VITE_HASH_SPHERE_URL=http://localhost:8091
VITE_CODE_VISUALIZER_URL=http://localhost:8092
# For production:
# VITE_HASH_SPHERE_URL=https://api.resonant.dev-swat.com:8091
# VITE_CODE_VISUALIZER_URL=https://api.resonant.dev-swat.com:8092

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/test/products (for test mode)
# or https://dashboard.stripe.com/products (for production)
VITE_STRIPE_TEAM_PRICE_ID=price_xxxxxxxxxxxxx
VITE_STRIPE_ENTERPRISE_PRICE_ID=price_xxxxxxxxxxxxx

# Stripe Publishable Key (optional, if using Stripe.js directly)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Sentry (optional)
# VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

