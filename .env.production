# Production Frontend Environment Variables
# All requests go through the gateway - no direct backend connections

# Main API Gateway (ALL requests route through here)
VITE_API_URL=https://api.dev-swat.com

# Stripe (Frontend only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# Optional: Monitoring URLs (Owner Dashboard only - these are external services)
# These are NOT backend services, they're separate monitoring tools
VITE_GRAFANA_URL=https://grafana.dev-swat.com
VITE_PROMETHEUS_URL=https://prometheus.dev-swat.com
VITE_ALERTMANAGER_URL=https://alertmanager.dev-swat.com

# Note: All backend services (build, state-physics, agent-engine, rara, etc.)
# are accessed through the gateway at VITE_API_URL
# The gateway routes requests to the appropriate backend service
