{
  "workflow_config": {
    "type": "sequential",
    "steps": [
      {
        "id": "profile",
        "agentId": "REPLACE_WITH_PERSONAL_PROFILE_EXTRACTOR_UUID",
        "inputKey": "userInput",
        "outputKey": "profile",
        "role": "Profile Extractor"
      },
      {
        "id": "metabolism",
        "agentId": "REPLACE_WITH_METABOLIC_CALCULATOR_UUID",
        "inputKey": "profile",
        "outputKey": "metabolicData",
        "role": "Metabolic Calculator"
      },
      {
        "id": "mealplan",
        "agentId": "REPLACE_WITH_MEAL_PLAN_GENERATOR_UUID",
        "inputKey": "metabolicData",
        "outputKey": "mealPlan",
        "role": "Meal Plan Builder"
      },
      {
        "id": "grocery",
        "agentId": "REPLACE_WITH_GROCERY_LIST_BUILDER_UUID",
        "inputKey": "mealPlan",
        "outputKey": "groceryList",
        "role": "Grocery Compiler"
      },
      {
        "id": "fitness",
        "agentId": "REPLACE_WITH_FITNESS_MOVEMENT_COACH_UUID",
        "inputKey": "profile",
        "outputKey": "fitnessPlan",
        "role": "Fitness Planner"
      },
      {
        "id": "sleep",
        "agentId": "REPLACE_WITH_SLEEP_STRESS_OPTIMIZATION_UUID",
        "inputKey": "profile",
        "outputKey": "sleepPlan",
        "role": "Sleep & Stress Planner"
      },
      {
        "id": "report",
        "agentId": "REPLACE_WITH_MASTER_LIFE_REPORT_COMPOSER_UUID",
        "inputKey": ["profile", "metabolicData", "mealPlan", "groceryList", "fitnessPlan", "sleepPlan"],
        "outputKey": "finalReport",
        "role": "Report Builder"
      }
    ]
  }
}

